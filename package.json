{
  "name": "elm-minesweeper",
  "version": "1.0.0",
  "description": "A minesweeper, inspired by gnome minesweeper, build in elm-lang",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "parc": "parcel",
    "content:generate": "node ./scripts/generate-content.js",
    "build": "npm run content:generate && parcel build public/**/*.{html,jpg,png,svg}",
    "start": "npm run content:generate && parcel public/**/*.{html,jpg,png,svg}",
    "make": "npm run content:generate && elm make",
    "repl": "elm repl",
    "reactor": "elm reactor",
    "test": "elm-test",
    "format": "elm-format ./src ./tests",
    "format-validate": "elm-format ./src ./tests --validate",
    "postinstall": "elm-tooling install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swissbite/elm-minesweeper.git"
  },
  "keywords": [
    "elm",
    "minesweeper",
    "game"
  ],
  "author": "David Däster <david@daester.net>",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Swissbite/elm-minesweeper/issues"
  },
  "homepage": "https://github.com/Swissbite/elm-minesweeper#readme",
  "devDependencies": {
    "@parcel/config-webextension": "^2.16.0",
    "@parcel/packager-raw-url": "^2.16.0",
    "@parcel/transformer-elm": "^2.16.0",
    "@parcel/transformer-webmanifest": "^2.16.0",
    "elm": "^0.19.1-6",
    "elm-frontmatter": "^2.1.2",
    "elm-hot": "^1.1.6",
    "elm-test": "^0.19.1-revision17",
    "elm-tooling": "^1.17.0",
    "node-elm-compiler": "^5.0.6",
    "parcel": "^2.16.0",
    "svgo": "^4.0.1"
  },
  "targets": {
    "frontend": {
      "distDir": "./build",
      "publicUrl": "/elm-minesweeper",
      "outputFormat": "esmodule"
    }
  },
  "overrides": {
    "sharp": "0.34.2",
    "minimatch": "3.1.4",
    "brace-expansion": "1.1.13"
  }
}
